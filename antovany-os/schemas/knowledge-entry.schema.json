{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antovany.com/schemas/knowledge-entry.schema.json",
  "title": "Antovany OS Knowledge Entry",
  "type": "object",
  "required": ["id", "title", "type", "domain", "summary", "evidence_status", "privacy", "as_of"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "type": {"type": "string", "enum": ["fact", "insight", "framework", "decision", "hypothesis", "case", "source", "skill", "metric"]},
    "domain": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "evidence_status": {"type": "string", "enum": ["VERIFIED", "SUPPORTED", "HYPOTHESIS", "NEEDS_VALIDATION", "TIME_SENSITIVE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "privacy": {"type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "as_of": {"type": "string", "format": "date"},
    "review_after": {"type": ["string", "null"], "format": "date"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "implications": {"type": "array", "items": {"type": "string"}},
    "decision_relevance": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {"type": "array", "items": {"type": "string"}},
    "related": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
